<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      Nearby Connections permission matrix. Getting this wrong is the single most likely
      silent demo-killer: it fails by discovering nothing, with no error. See
      permissions/MeshPermissions.kt for the runtime request that mirrors this list.
    -->

    <!-- Pre-12 (API <= 30) -->
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" android:maxSdkVersion="28" />

    <!--
      Nearby needed this for BLE scans on API 29..31 only; that's why a maxSdkVersion cap used
      to sit here. Now requested unconditionally for the separate, optional GPS-on-SOS feature
      (see permissions/MeshPermissions.kt's LOCATION_PERMISSION and sensors/GpsBridge.kt) — a
      fix is never required to use the mesh, only to attach a coordinate to one's own SOS.
    -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <!-- 12+ (API 31+) -->
    <uses-permission android:name="android.permission.BLUETOOTH_ADVERTISE" tools:targetApi="s" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" tools:targetApi="s" />
    <uses-permission
        android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation"
        tools:targetApi="s" />

    <!-- 13+ (API 33+) -->
    <uses-permission
        android:name="android.permission.NEARBY_WIFI_DEVICES"
        android:usesPermissionFlags="neverForLocation"
        tools:targetApi="tiramisu" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" tools:targetApi="tiramisu" />

    <!-- Wi-Fi Direct / local WLAN upgrade path -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />

    <!--
      Nearby Connections itself never needs this — it's IPC to Play Services, not a raw
      socket. GatewayServer's NanoHTTPD ServerSocket does: without it, Android denies the
      socket() syscall outright (SocketException: EPERM), not a bind/port failure. Every
      other permission above is for L0 discovery; this one is for L3's dashboard server.
    -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!--
      Optional, exactly like ACCESS_FINE_LOCATION above: the microphone enriches an SOS but is
      never required to send one (see permissions/MeshPermissions.kt's MICROPHONE_PERMISSION
      and sensors/AudioBridge.kt). Declining it leaves three of the sixteen feature slots at
      zero and changes nothing else.
    -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Scanning must survive screen-off -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission
        android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE"
        tools:targetApi="upside_down_cake" />
    <!--
      14+ (API 34): a foreground service that touches the microphone must hold the matching
      typed permission as well as declaring the type below. Since Android 11 the type is also
      what permits recording at all while the app is not in front — without it AudioRecord
      returns silence rather than an error, which is the same silent-failure shape as a missing
      Nearby permission.
    -->
    <uses-permission
        android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE"
        tools:targetApi="upside_down_cake" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <application
        android:allowBackup="false"
        android:label="Ground-Zero Mesh"
        android:supportsRtl="true"
        android:theme="@style/Theme.GroundZeroMesh">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".service.MeshForegroundService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice|microphone" />

    </application>
</manifest>
